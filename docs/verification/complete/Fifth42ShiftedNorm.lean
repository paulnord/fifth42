import Mathlib.Tactic.Ring

/-! Explicit conjugate-product and unit-digit arithmetic for the fixed
radicand 42. These identities are not the local norm theorem. -/
namespace Fifth42

set_option maxHeartbeats 8000000
set_option maxRecDepth 100000

/-- Product over the five Kummer conjugates of the shifted cube. -/
theorem shifted_cube_product {R : Type} [CommRing R] (a z t : R)
    (ha : a^5 = 42) (hz : z^4+z^3+z^2+z+1=0) :
    (1+t*(a-2)^3)*(1+t*(z*a-2)^3)*(1+t*(z^2*a-2)^3)*
      (1+t*(z^3*a-2)^3)*(1+t*(z^4*a-2)^3) =
       1-40*t+1900*t^2+85600*t^3+716000*t^4+1000*t^5 := by
  have ha0 : a^5-42=0 := sub_eq_zero.mpr ha
  have reduce_step (x y u v : R) (hh : x = y+u*(a^5-42)+v*(z^4+z^3+z^2+z+1)) :
      x = y := by simpa [ha0,hz] using hh
  have f0 : (z^0*a-2)^3 = a^3 - 6*a^2 + 12*a - 8 := by
    apply reduce_step _ _ (0) (0)
    clear ha hz ha0 reduce_step
    ring
  have f₀ : (a-2)^3 = a^3 - 6*a^2 + 12*a - 8 := by ring
  have f1 : (z^1*a-2)^3 = a^3*z^3 - 6*a^2*z^2 + 12*a*z - 8 := by
    apply reduce_step _ _ (0) (0)
    clear ha hz ha0 reduce_step f0 f₀
    ring
  have f2 : (z^2*a-2)^3 = a^3*z + 6*a^2*z^3 + 6*a^2*z^2 + 6*a^2*z + 6*a^2 + 12*a*z^2 - 8 := by
    apply reduce_step _ _ (0) (a^3*z^2 - a^3*z - 6*a^2)
    clear ha hz ha0 reduce_step f0 f₀ f1
    ring
  have f3 : (z^3*a-2)^3 = -a^3*z^3 - a^3*z^2 - a^3*z - a^3 - 6*a^2*z + 12*a*z^3 - 8 := by
    apply reduce_step _ _ (0) (a^3*z^5 - a^3*z^4 + a^3 - 6*a^2*z^2 + 6*a^2*z)
    clear ha hz ha0 reduce_step f0 f₀ f1 f2
    ring
  have f4 : (z^4*a-2)^3 = a^3*z^2 - 6*a^2*z^3 - 12*a*z^3 - 12*a*z^2 - 12*a*z - 12*a - 8 := by
    apply reduce_step _ _ (0) (a^3*z^8 - a^3*z^7 + a^3*z^3 - a^3*z^2 - 6*a^2*z^4 + 6*a^2*z^3 + 12*a)
    clear ha hz ha0 reduce_step f0 f₀ f1 f2 f3
    ring
  rw [f₀, show (z*a-2)^3 = _ from by simpa [pow_one] using f1, f2, f3, f4]
  have h0 : 1+t*(a^3 - 6*a^2 + 12*a - 8) = a^3*t - 6*a^2*t + 12*a*t - 8*t + 1 := by ring
  have h1 : (a^3*t - 6*a^2*t + 12*a*t - 8*t + 1)*(1+t*(a^3*z^3 - 6*a^2*z^2 + 12*a*z - 8)) = 12*a^4*t^2*z^3 + 36*a^4*t^2*z^2 + 12*a^4*t^2*z - 8*a^3*t^2*z^3 - 72*a^3*t^2*z^2 - 72*a^3*t^2*z - 8*a^3*t^2 + a^3*t*z^3 + a^3*t + 48*a^2*t^2*z^2 + 144*a^2*t^2*z + 48*a^2*t^2 - 6*a^2*t*z^2 - 6*a^2*t + 42*a*t^2*z^3 - 96*a*t^2*z - 96*a*t^2 + 12*a*t*z + 12*a*t - 252*t^2*z^3 - 252*t^2*z^2 + 64*t^2 - 16*t + 1 := by
    apply reduce_step _ _ (a*t^2*z^3 - 6*t^2*z^3 - 6*t^2*z^2) (0)
    clear ha hz ha0 reduce_step f0 f₀ f1 f2 f3 f4 h0
    ring
  have h2 : (12*a^4*t^2*z^3 + 36*a^4*t^2*z^2 + 12*a^4*t^2*z - 8*a^3*t^2*z^3 - 72*a^3*t^2*z^2 - 72*a^3*t^2*z - 8*a^3*t^2 + a^3*t*z^3 + a^3*t + 48*a^2*t^2*z^2 + 144*a^2*t^2*z + 48*a^2*t^2 - 6*a^2*t*z^2 - 6*a^2*t + 42*a*t^2*z^3 - 96*a*t^2*z - 96*a*t^2 + 12*a*t*z + 12*a*t - 252*t^2*z^3 - 252*t^2*z^2 + 64*t^2 - 16*t + 1)*(1+t*(a^3*z + 6*a^2*z^3 + 6*a^2*z^2 + 6*a^2*z + 6*a^2 + 12*a*z^2 - 8)) = 150*a^4*t^3*z^3 + 630*a^4*t^3*z^2 + 630*a^4*t^3*z + 150*a^4*t^3 - 24*a^4*t^2*z^3 + 24*a^4*t^2*z^2 + 24*a^4*t^2*z - 24*a^4*t^2 + 640*a^3*t^3*z^3 - 260*a^3*t^3*z - 260*a^3*t^3 + 128*a^3*t^2*z^3 + 56*a^3*t^2*z + 56*a^3*t^2 + a^3*t*z^3 + a^3*t*z + a^3*t + 240*a^2*t^3*z^3 + 360*a^2*t^3*z^2 + 240*a^2*t^3*z + 48*a^2*t^2*z^3 + 144*a^2*t^2*z^2 + 48*a^2*t^2*z + 6*a^2*t*z^3 + 6*a^2*t*z - 1920*a*t^3*z^2 - 5280*a*t^3*z - 1920*a*t^3 - 234*a*t^2*z^2 - 192*a*t^2*z - 234*a*t^2 + 12*a*t*z^2 + 12*a*t*z + 12*a*t - 10080*t^3*z^3 - 10080*t^3*z^2 + 3520*t^3 - 252*t^2*z^3 - 252*t^2*z^2 + 444*t^2 - 24*t + 1 := by
    apply reduce_step _ _ (12*a^2*t^3*z^4 + 36*a^2*t^3*z^3 + 12*a^2*t^3*z^2 + 72*a*t^3*z^6 + 288*a*t^3*z^5 + 352*a*t^3*z^4 + 288*a*t^3*z^3 + 216*a*t^3*z^2 + 64*a*t^3*z + a*t^2*z^4 + a*t^2*z - 48*t^3*z^6 - 336*t^3*z^5 - 480*t^3*z^4 - 768*t^3*z^3 - 768*t^3*z^2 - 432*t^3*z - 48*t^3 + 6*t^2*z^6 + 6*t^2*z^5 + 6*t^2*z^4 + 6*t^2*z^3 + 6*t^2*z^2 + 6*t^2) (192*a^4*t^3*z + 138*a^4*t^3 - 24*a^4*t^2*z - 12*a^4*t^2 + 252*a^3*t^3*z^2 - 252*a^3*t^3 - 1512*a^2*t^3*z^2 - 1008*a^2*t^3*z + 3024*a*t^3*z^2 + 6048*a*t^3*z + 2688*a*t^3 + 42*a*t^2 - 2016*t^3*z^2 - 12096*t^3*z - 6048*t^3 + 252*t^2*z^2)
    clear ha hz ha0 reduce_step f0 f₀ f1 f2 f3 f4 h0 h1
    ring
  have h3 : (150*a^4*t^3*z^3 + 630*a^4*t^3*z^2 + 630*a^4*t^3*z + 150*a^4*t^3 - 24*a^4*t^2*z^3 + 24*a^4*t^2*z^2 + 24*a^4*t^2*z - 24*a^4*t^2 + 640*a^3*t^3*z^3 - 260*a^3*t^3*z - 260*a^3*t^3 + 128*a^3*t^2*z^3 + 56*a^3*t^2*z + 56*a^3*t^2 + a^3*t*z^3 + a^3*t*z + a^3*t + 240*a^2*t^3*z^3 + 360*a^2*t^3*z^2 + 240*a^2*t^3*z + 48*a^2*t^2*z^3 + 144*a^2*t^2*z^2 + 48*a^2*t^2*z + 6*a^2*t*z^3 + 6*a^2*t*z - 1920*a*t^3*z^2 - 5280*a*t^3*z - 1920*a*t^3 - 234*a*t^2*z^2 - 192*a*t^2*z - 234*a*t^2 + 12*a*t*z^2 + 12*a*t*z + 12*a*t - 10080*t^3*z^3 - 10080*t^3*z^2 + 3520*t^3 - 252*t^2*z^3 - 252*t^2*z^2 + 444*t^2 - 24*t + 1)*(1+t*(-a^3*z^3 - a^3*z^2 - a^3*z - a^3 - 6*a^2*z + 12*a*z^3 - 8)) = 7200*a^4*t^4*z + 1590*a^4*t^3*z + 60*a^4*t^2*z + 15200*a^3*t^4*z^2 - 120*a^3*t^3*z^2 - 120*a^3*t^2*z^2 - a^3*t*z^2 + 32100*a^2*t^4*z^3 + 360*a^2*t^3*z^3 + 6*a^2*t*z^3 - 67800*a*t^4*z^3 - 67800*a*t^4*z^2 - 67800*a*t^4*z - 67800*a*t^4 - 9120*a*t^3*z^3 - 9120*a*t^3*z^2 - 9120*a*t^3*z - 9120*a*t^3 - 330*a*t^2*z^3 - 330*a*t^2*z^2 - 330*a*t^2*z - 330*a*t^2 + 12*a*t*z^3 + 12*a*t*z^2 + 12*a*t*z + 12*a*t + 143200*t^4 + 34240*t^3 + 1140*t^2 - 32*t + 1 := by
    apply reduce_step _ _ (-150*a^2*t^4*z^6 - 780*a^2*t^4*z^5 - 1410*a^2*t^4*z^4 - 1560*a^2*t^4*z^3 - 1410*a^2*t^4*z^2 - 780*a^2*t^4*z - 150*a^2*t^4 + 24*a^2*t^3*z^6 - 24*a^2*t^3*z^4 - 24*a^2*t^3*z^2 + 24*a^2*t^3 - 640*a*t^4*z^6 - 640*a*t^4*z^5 - 1280*a*t^4*z^4 - 3900*a*t^4*z^3 - 3260*a*t^4*z^2 - 380*a*t^4*z + 260*a*t^4 - 128*a*t^3*z^6 - 128*a*t^3*z^5 - 40*a*t^3*z^4 - 384*a*t^3*z^3 - 256*a*t^3*z^2 + 32*a*t^3*z - 56*a*t^3 - a*t^2*z^6 - a*t^2*z^5 - 2*a*t^2*z^4 - 3*a*t^2*z^3 - 2*a*t^2*z^2 - 2*a*t^2*z - a*t^2 + 1560*t^4*z^6 + 6960*t^4*z^5 + 2880*t^4*z^4 + 960*t^4*z^3 + 960*t^4*z^2 + 1320*t^4*z - 336*t^3*z^6 + 96*t^3*z^5 - 720*t^3*z^4 - 528*t^3*z^3 - 528*t^3*z^2 - 384*t^3*z - 6*t^2*z^6 - 6*t^2*z^5 - 18*t^2*z^4 - 12*t^2*z^3 - 12*t^2*z^2 - 12*t^2*z) (7680*a^4*t^4*z^2 - 5760*a^4*t^4*z + 720*a^4*t^4 + 1536*a^4*t^3*z^2 - 1302*a^4*t^3*z + 576*a^4*t^3 + 12*a^4*t^2*z^2 - 24*a^4*t^2*z - 36*a^4*t^2 + 12960*a^3*t^4*z^2 + 11520*a^3*t^4*z - 1440*a^3*t^4 + 828*a^3*t^3*z^2 + 1404*a^3*t^3*z - 1152*a^3*t^3 + 72*a^3*t^2*z^2 - 72*a^3*t^2*z + 72*a^3*t^2 - 6300*a^2*t^4*z^2 - 49500*a^2*t^4*z - 6300*a^2*t^4 + 1008*a^2*t^3*z^2 - 3816*a^2*t^3*z + 1008*a^2*t^3 + 144*a^2*t^2*z - 147840*a*t^4*z^2 + 94080*a*t^4 - 8400*a*t^3*z^2 + 6720*a*t^3 - 42*a*t^2*z^2 - 42*a*t^2 + 65520*t^4*z^2 + 226800*t^4*z - 171360*t^4 - 14112*t^3*z^2 + 18144*t^3*z - 34272*t^3 - 252*t^2*z^2 - 504*t^2)
    clear ha hz ha0 reduce_step f0 f₀ f1 f2 f3 f4 h0 h1 h2
    ring
  have h4 : (7200*a^4*t^4*z + 1590*a^4*t^3*z + 60*a^4*t^2*z + 15200*a^3*t^4*z^2 - 120*a^3*t^3*z^2 - 120*a^3*t^2*z^2 - a^3*t*z^2 + 32100*a^2*t^4*z^3 + 360*a^2*t^3*z^3 + 6*a^2*t*z^3 - 67800*a*t^4*z^3 - 67800*a*t^4*z^2 - 67800*a*t^4*z - 67800*a*t^4 - 9120*a*t^3*z^3 - 9120*a*t^3*z^2 - 9120*a*t^3*z - 9120*a*t^3 - 330*a*t^2*z^3 - 330*a*t^2*z^2 - 330*a*t^2*z - 330*a*t^2 + 12*a*t*z^3 + 12*a*t*z^2 + 12*a*t*z + 12*a*t + 143200*t^4 + 34240*t^3 + 1140*t^2 - 32*t + 1)*(1+t*(a^3*z^2 - 6*a^2*z^3 - 12*a*z^3 - 12*a*z^2 - 12*a*z - 12*a - 8)) = 1000*t^5 + 716000*t^4 + 85600*t^3 + 1900*t^2 - 40*t + 1 := by
    apply reduce_step _ _ (7200*a^2*t^5*z^3 + 1590*a^2*t^4*z^3 + 60*a^2*t^3*z^3 - 28000*a*t^5*z^4 - 9660*a*t^4*z^4 - 480*a*t^3*z^4 - a*t^2*z^4 - 59100*t^5*z^5 - 86400*t^5*z^4 - 86400*t^5*z^3 - 86400*t^5*z^2 - 86400*t^5*z + 1080*t^4*z^5 - 19080*t^4*z^4 - 19080*t^4*z^3 - 19080*t^4*z^2 - 19080*t^4*z + 720*t^3*z^5 - 720*t^3*z^4 - 720*t^3*z^3 - 720*t^3*z^2 - 720*t^3*z + 12*t^2*z^5) (-192600*a^4*t^5*z^2 - 57600*a^4*t^5*z - 2160*a^4*t^4*z^2 - 5520*a^4*t^4*z + 1110*a^4*t^3*z - 36*a^4*t^2*z^2 + 60*a^4*t^2*z + 21600*a^3*t^5*z^2 + 50400*a^3*t^4*z^2 + 1980*a^3*t^3*z^2 - 144*a^3*t^2*z^2 + 813600*a^2*t^5*z^2 + 813600*a^2*t^5*z + 813600*a^2*t^5 + 109440*a^2*t^4*z^2 + 109440*a^2*t^4*z + 109440*a^2*t^4 + 3960*a^2*t^3*z^2 + 3960*a^2*t^3*z + 3960*a^2*t^3 - 144*a^2*t^2*z^2 - 144*a^2*t^2*z - 144*a^2*t^2 - 1176000*a*t^5 - 405720*a*t^4 - 20160*a*t^3 - 42*a*t^2 - 2482200*t^5*z - 1146600*t^5 + 45360*t^4*z - 846720*t^4 + 30240*t^3*z - 60480*t^3 + 504*t^2*z - 504*t^2)
    clear ha hz ha0 reduce_step f0 f₀ f1 f2 f3 f4 h0 h1 h2 h3
    ring
  rw [h0,h1,h2,h3,h4]
  clear ha hz ha0 reduce_step f0 f₀ f1 f2 f3 f4 h0 h1 h2 h3 h4
  ring

#print axioms shifted_cube_product

end Fifth42
